{
  "permissions": {
    "allow": [
      "Bash(node *)",
      "Bash(npm install *)",
      "Bash(npm ci)",
      "Bash(npx wrangler *)",
      "Bash(wrangler *)",
      "Bash(jq *)",
      "Bash(git status*)",
      "Bash(git add *)",
      "Bash(git commit *)",
      "Bash(git push*)",
      "Bash(curl http://localhost:*)",
      "Bash(ls *)",
      "Bash(cat *)"
    ]
  },
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "bash \"$CLAUDE_PROJECT_DIR/.claude/hooks/pre-deploy-tests.sh\""
          }
        ]
      }
    ]
  }
}
